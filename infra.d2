DEL.Download Fanbox --> Data."invalid.work-1.JuiceFS".duplicity : {
    label: duplicity
}

Services."com.lowiro.arcaea".play record --> DEL.Y-Offline
DEL.Y-Offline --> Data."invalid.node.lexikos.filesystem".Y-Offline DB
Data."invalid.node.lexikos.filesystem"."Y-Offline DB" --> DAL.Y-Offline
Data."invalid.node.lexikos.filesystem".ArcaeaSongDatabase --> DAL.Y-Offline
DAL.Y-Offline --> Applications.Y-Offline

Services."cn.arcaea.wiki" --> DEL.arcaea-database-maintainer
DEL.arcaea-database-maintainer --> Data."invalid.node.lexikos.filesystem".ArcaeaSongDatabase : {
    label: manually run script
}

Services."com.youtube" --> DEL.Google Takeout.youtube
DEL.Google Takeout.youtube --> Data."invalid.node.laborari.filesystem".Takeout.youtube

Services."com.google.mail" --> DEL.Google Takeout.mail
DEL.Google Takeout.mail --> Data."invalid.node.laborari.filesystem".Takeout.mail

Services."org.terraria".footage --> DEL.bili-uploader
