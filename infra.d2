DEL: Data Export Layer {
    web-scrobbler {
        link: https://github.com/web-scrobbler/web-scrobbler
        shape: package
    }
    Accounting {
        shape: person
    }
    Download Fanbox {
        shape: person
    }
    Y-Offline {
        shape: person
    }
    arcaea-database-maintainer {
        shape: person
        arcaea-database-maintainer {
            shape: package
        }
    }
    bili-uploader {
        shape: person
    }
    duplicity {
        shape: package
        link: https://duplicity.gitlab.io/
        lexikos
        proximo
    }
    ghorg {
        shape: package
        link: https://github.com/gabrie30/ghorg
    }
    Export Scale Image {
        shape: person
    }
    Sync On Edit (Git)
    Google Takeout {
        shape: person
        tooltip: once per 2 months, manually download
        youtube
        mail
    }
    Export to Photos {
        shape: person
    }
}

Data {
    "fm.libre" {
        link: https://libre.fm
        shape: cloud
    }
    "beancount": "beancount (x2)" {
        shape: stored_data
    }
    "invalid.node.lexikos.filesystem" {
        fanbox: "fanbox (x2)" {
            shape: stored_data
        }
        "Y-Offline DB" {
            shape: cylinder
        }
    }
    "com.bilibili.user-1" {
        shape: cloud
        uploads {
            shape: stored_data
        }
    }
    "com.github" {
        shape: cloud
        ArcaeaSongDatabase: "ArcaeaSongDatabase (x2)" {
            link: https://github.com/CuSO4Deposit/ArcaeaSongDatabase
        }
        logseq: "logseq (x2)"
        beancount: "beancount (x2)"
    }
    "invalid.work-1.JuiceFS" {
        duplicity {
            shape: stored_data
        }
    }
    "invalid.device.phone-2.filesystem" {
        scale info pictures
    }
    "invalid.node.proximo.filesystem" {
        ghorg {
            shape: stored_data
        }
        digikam {
            shape: stored_data
        }
        piwigo {
            shape: stored_data
        } 
    }
    "invalid.node.lexikos.filesystem" {
        ArcaeaSongDatabase: "ArcaeaSongDatabase (x2)"
    }

    "invalid.node.lexikos.filesystem".ArcaeaSongDatabase --> "com.github".ArcaeaSongDatabase : {
        label: git push
    }
    "beancount" --> "com.github".beancount : {
        label: git push
    }
    "invalid.node.laborari.filesystem".Takeout {
        youtube {
            shape: stored_data
        }
        mail {
            shape: stored_data
        }
    }
}

